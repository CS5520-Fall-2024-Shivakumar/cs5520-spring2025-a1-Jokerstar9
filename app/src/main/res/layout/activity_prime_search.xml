<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">


    <Space
        android:layout_width="match_parent"
        android:layout_height="100dp"/>

    <TextView
        android:id="@+id/currentNumberTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Checking: "
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/latestPrimeTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Latest Prime: "
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="8dp"/>

    <CheckBox
        android:id="@+id/pacifierSwitch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pacifier Switch"
        android:layout_marginTop="12dp" />

    <Button
        android:id="@+id/findPrimesButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Find Primes"
        android:layout_marginTop="16dp" />

    <Button
        android:id="@+id/terminateSearchButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Terminate Search"
        android:layout_marginTop="8dp" />

</LinearLayout>